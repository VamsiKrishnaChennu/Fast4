# Copy to server/.env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/npatarena
JWT_ACCESS_SECRET=change-me-32-or-more-random-characters
JWT_REFRESH_SECRET=change-me-different-32-or-more-random-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
LOG_LEVEL=info
OTP_VERIFICATION_ENABLED=false
JUDGE_ENABLED=true
WIKIDATA_USER_AGENT=FastFour/1.0 (creatiquework@gmail.com)
DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
APP_ORIGIN=http://localhost:4000
SUPPORT_EMAIL=creatiquework@gmail.com
ANDROID_PACKAGE_NAME=com.npatarena.app
ANDROID_SHA256_FINGERPRINTS=
# Password reset email (Gmail SMTP with an app password; needs 2-step verification on the account)
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=creatiquework@gmail.com
SMTP_PASS=
EMAIL_FROM="Fast Four <creatiquework@gmail.com>"
SENTRY_DSN=
