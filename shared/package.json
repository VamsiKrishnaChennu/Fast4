{
  "name": "@fastfour/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --coverage"
  },
